diff --git a/src/runner/update-worker-cli.ts b/src/runner/update-worker-cli.ts
new file mode 100644
index 0000000000000000000000000000000000000000..25883ce062b37f78d334807c09c00d2a403d35d8
--- /dev/null
+++ b/src/runner/update-worker-cli.ts
@@ -0,0 +1,23 @@
+import { fileURLToPath } from "node:url";
+import { runUpdateWorker } from "./update-worker.js";
+
+// Keep CLI startup separate from the worker helpers imported by the main runner bundle.
+function argument(name: string): string | undefined {
+	const index = process.argv.indexOf(name);
+	return index >= 0 ? process.argv[index + 1] : undefined;
+}
+
+async function main(): Promise<void> {
+	if (process.argv.includes("--help")) {
+		console.log("Usage: cozyagents-update.mjs --home <path> --operation-id <runner_maintenance_id>");
+		return;
+	}
+	const home = argument("--home");
+	const operationId = argument("--operation-id");
+	if (!home || !operationId) throw new Error("update_worker_invalid: --home and --operation-id are required");
+	await runUpdateWorker({ home, operationId });
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
+	void main().catch(() => { process.exitCode = 1; });
+}
