diff --git a/scripts/test/bundle-entrypoints.mjs b/scripts/test/bundle-entrypoints.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b269770fa6e85df12bddecfa8975db4460bc4890
--- /dev/null
+++ b/scripts/test/bundle-entrypoints.mjs
@@ -0,0 +1,39 @@
+#!/usr/bin/env node
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { copyFileSync, mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+
+const bundle = resolve(process.argv[2] ?? "dist-bundle/cozyagents.mjs");
+const version = JSON.parse(readFileSync(new URL("../../package.json", import.meta.url), "utf8")).version;
+const stage = mkdtempSync(join(tmpdir(), "cozyagents-entrypoints-"));
+const workerUsage = "Usage: cozyagents-update.mjs --home <path> --operation-id <runner_maintenance_id>";
+
+function run(entry, args, status = 0) {
+  const result = spawnSync(process.execPath, [join(stage, entry), ...args], {
+    cwd: stage, encoding: "utf8", timeout: 30_000, windowsHide: true,
+  });
+  assert.ifError(result.error);
+  assert.equal(result.status, status, `${entry} ${args.join(" ")}: ${result.stderr}`);
+  assert.equal(result.stderr, "", `${entry} ${args.join(" ")} must not write stderr`);
+  return result.stdout.trim();
+}
+
+try {
+  // These are installed as standalone files, with no source tree or node_modules beside them.
+  copyFileSync(bundle, join(stage, "cozyagents.mjs"));
+  copyFileSync(join(dirname(bundle), "cozyagents-update.mjs"), join(stage, "cozyagents-update.mjs"));
+  assert.equal(run("cozyagents.mjs", ["--version"]), version);
+  for (const args of [["--help"], ["runner", "--help"]]) {
+    const help = run("cozyagents.mjs", args);
+    assert.match(help, /^CozyAgents \(Pi /);
+    assert.match(help, /cozyagents runner/);
+    assert.ok(!help.includes(workerUsage), "CLI help must not execute the update worker entrypoint");
+  }
+  assert.equal(run("cozyagents-update.mjs", ["--help"]), workerUsage);
+  assert.equal(run("cozyagents-update.mjs", [], 1), "");
+  console.log("OK    isolated CLI and update worker entrypoints run independently");
+} finally {
+  rmSync(stage, { recursive: true, force: true });
+}
