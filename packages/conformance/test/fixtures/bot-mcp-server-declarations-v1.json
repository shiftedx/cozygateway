        },
        "description": "lights, climate and scenes",
        "tools": [
          "GetLiveContext",
          "HassTurnOn",
          "HassTurnOff"
        ],
        "actions": {
          "HassTurnOn": [
            "light",
            "switch"
          ]
        }
      },
