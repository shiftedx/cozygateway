# Copy to .env. A strong random token the attaching agent plugin must present on /attach.
COZYGATEWAY_ATTACH_TOKEN=change-me-to-a-long-random-string
# Optional: override the relay listen/host port.
COZY_RELAY_PORT=8788
# Optional TLS (docs/tls.md). Leave all of this commented out to serve plain HTTP, which is the
# default and is correct behind a reverse proxy.
#
# Option A, the Caddy sidecar (docker-compose.tls-caddy.yml): the name the phone will dial.
# COZY_TLS_HOSTNAME=homelab.lan
#
# Option B, gateway-native TLS (docker-compose.tls-native.yml): host paths to your PEM pair. Both
# or neither -- one alone makes the gateway refuse to start rather than serve plaintext.
# COZY_TLS_CERT_HOST_PATH=./secrets/cert.pem
# COZY_TLS_KEY_HOST_PATH=./secrets/key.pem

# Optional APNs (real iOS push). Set all five and mount your .p8, or leave unset for webhook-only.
# APNS_KEY_P8_HOST_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_P8_PATH=/keys/apns.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=YYYYYYYYYY
# APNS_TOPIC=com.cozylabs.cozychat
# APNS_ENVIRONMENT=development
