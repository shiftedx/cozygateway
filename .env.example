# Docker only: copy this file to .env, then point Compose at a Hermes-only config and a separate
# mode-600 secrets file. Start from docker/cozygateway.config.example.json; it contains env NAMES,
# never credentials. The config directory must be writable by the image's non-root UID 1000.
COZYGATEWAY_CONFIG_DIR=./local/config
COZYGATEWAY_SECRETS_FILE=./local/secrets/cozygateway.env
# Push defaults to the CozyLabs relay, with end-to-end encrypted payloads. A self-hosted relay
# cannot push to the store app because APNs keys are scoped to the publisher team.
COZYGATEWAY_PUSH_RELAY_URL=https://push.cozylabs.ai
# Optional local developer relay: set the URL to http://relay:8788 and start compose with
# --profile local-push. This is useful only with an app and APNs key from your own Apple team.
COZY_RELAY_PORT=8788
# Optional CozyRunner lane (contract/runner-v1.md, capability 49). Set this to a long random secret
# to let a CozyRunner attach at /runner/v1 and create bot containers on this host; place the SAME
# value in the runner's COZYRUNNER_TOKEN. It belongs in the mode-600 secrets file, not here.
# Without it the gateway still accepts `POST /bots {"runtime": "cozyagents"}`: the bot exists and
# waits in `waiting_for_runner` until a runner attaches.
# COZYGATEWAY_RUNNER_TOKEN=
# What a new runtime bot is built from. All optional: anything unset is left to the runner's own
# compose defaults rather than guessed at here.
# COZYGATEWAY_RUNNER_IMAGE=ghcr.io/shiftedx/cozyagents@sha256:...
# COZYGATEWAY_RUNNER_ENTRYPOINT=cozyagents
# COZYGATEWAY_RUNNER_MODEL_ID=
# COZYGATEWAY_RUNNER_MODEL_PROVIDER=
# COZYGATEWAY_RUNNER_MODEL_ENDPOINT=
# COZYGATEWAY_RUNNER_CPUS=2
# COZYGATEWAY_RUNNER_MEMORY_MB=2048
# COZYGATEWAY_RUNNER_PIDS=512
# Optional TLS (docs/tls.md). Leave all of this commented out to serve plain HTTP, which is the
# default and is correct behind a reverse proxy.
#
# Option A, the Caddy sidecar (docker-compose.tls-caddy.yml): the name the phone will dial.
# COZY_TLS_HOSTNAME=homelab.lan
#
# Option B, gateway-native TLS (docker-compose.tls-native.yml): host paths to your PEM pair. Both
# or neither -- one alone makes the gateway refuse to start rather than serve plaintext.
# COZY_TLS_CERT_HOST_PATH=./secrets/cert.pem
# COZY_TLS_KEY_HOST_PATH=./secrets/key.pem

# Optional local-push APNs. Set all four and mount your .p8, or leave unset for webhook-only.
# APNS_KEY_P8_HOST_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_P8_PATH=/keys/apns.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=YYYYYYYYYY
# APNS_TOPIC=com.cozylabs.cozychat
